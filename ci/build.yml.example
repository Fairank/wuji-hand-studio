name: Desktop packages
on:
  workflow_dispatch:
  push:
    tags: ['v*']
permissions:
  contents: write
jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, ubuntu-22.04, macos-14]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Ubuntu rendering libraries
        if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y libgl1 libglfw3 libegl1 xvfb
      - run: python -m pip install -r requirements-build.txt
      - name: Offline regression checks
        env:
          PYTHONPATH: src
        run: python -m unittest discover -s src -p "test_*.py"
      - name: Build native package and check native hand assets
        run: python build.py
      - name: Render check on Linux
        if: runner.os == 'Linux'
        run: xvfb-run -a python src/desktop.py --self-check --render-check
      - uses: actions/upload-artifact@v4
        with:
          name: WujiStudio-${{ runner.os }}
          path: |
            dist/*.zip
            dist/*.tar.gz
            dist/*.sha256
      - name: Attach packages to release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          draft: true
          files: |
            dist/*.zip
            dist/*.tar.gz
            dist/*.sha256
          body: |
            Unofficial personal demonstration tool. 非官方个人展示工具。
            Native packages are unsigned. Please read the platform/controller instructions.
            Hardware operation has not been validated on these new packages.
