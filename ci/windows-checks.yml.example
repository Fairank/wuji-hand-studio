name: Windows software checks

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  software-checks:
    runs-on: windows-latest
    timeout-minutes: 20
    env:
      PYTHONPATH: src
      PYTHONDONTWRITEBYTECODE: '1'
      WUJI_STUDIO_DATA: ${{ runner.temp }}\hand-workbench-ci-data
      WUJI_RELEASE_QA_ROOT: ${{ runner.temp }}\hand-workbench-ci-qa\release
      WUJI_TELEMETRY_DISABLE: '1'
      WUJI_NO_UPDATE_CHECK: '1'
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: requirements.txt
      - name: Install application requirements
        run: python -m pip install -r requirements.txt
      - name: Check source syntax without importing or running the application
        run: >-
          python -c "import ast, pathlib; files = [*pathlib.Path('src').rglob('*.py'), *pathlib.Path('scripts').rglob('*.py'), pathlib.Path('build.py')]; [ast.parse(p.read_text(encoding='utf-8-sig'), filename=str(p)) for p in files]; print(str(len(files)) + ' Python files parsed')"
      - name: Test release failures with synthetic installers and mocked processes
        run: python -m unittest discover -s src -p test_release_recovery.py -v
      # This named subset has no SDK, physical-device, GUI or renderer starts.
      # It does not claim native/installer/device acceptance or the entire suite.
      - name: Run existing isolated software regressions
        run: >-
          python -m unittest
          test_workbench_update test_stream_rates test_timing_stats
          test_interval_summary test_parameter_file_fable test_playlist_plan
          test_phrase_text test_official_policy_fable -v
      - name: Test device-state and component recovery with mocks
        run: >-
          python -m unittest
          test_device_termination test_control_recovery test_official_tools
          test_runtime_repair test_glove_view test_glove_user_lifetime
          test_calibration_cli test_native_bounds -v
