name: macOS app with bundled Linux
on:
  workflow_dispatch:
    inputs:
      publish_preview:
        description: Publish a clearly marked preview after successful verification
        type: boolean
        default: false
  push:
    tags: ['macos-v*']
permissions:
  contents: read
concurrency:
  group: macos-package-${{ github.ref }}
  cancel-in-progress: false
jobs:
  build:
    runs-on: macos-15
    timeout-minutes: 55
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          architecture: arm64
      - name: Install app build dependencies
        run: python -m pip install -r requirements.txt 'pyinstaller>=6.15,<7'
      - name: Platform-neutral regression suite
        run: python -m unittest discover -s src -p 'test_*.py'
      - name: Image build tool (not required on the user's Mac)
        run: brew list qemu >/dev/null 2>&1 || brew install qemu
      - name: Prepare pinned Linux and Lima bundle
        run: python scripts/prepare_macos_payload.py
      - name: Build native Mac app
        run: python build.py
      - name: Verify app bundle
        run: python scripts/verify_macos_bundle.py
      - uses: actions/upload-artifact@v4
        with:
          name: HandWorkbench-macos-arm64-with-linux
          path: |
            dist/HandWorkbench-*-macos-arm64.zip
            dist/HandWorkbench-*-macos-arm64.zip.sha256
            dist/macos-validation.json
          if-no-files-found: error
          retention-days: 30
  publish:
    if: startsWith(github.ref, 'refs/tags/macos-v') || inputs.publish_preview
    needs: build
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: HandWorkbench-macos-arm64-with-linux
          path: artifacts
      - name: Upload Mac preview package
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          tag="macos-v0.1.9-preview.${GITHUB_RUN_NUMBER}"
          if [[ "$GITHUB_REF" == refs/tags/macos-v* ]]; then tag="$GITHUB_REF_NAME"; fi
          gh release create "$tag" artifacts/* --target "$GITHUB_SHA" --repo "$GITHUB_REPOSITORY" --prerelease --title "Hand Workbench macOS preview · bundled Linux" --notes "Apple Silicon native desktop app with a bundled Ubuntu disk and Lima. First Linux setup needs internet. Unofficial personal tool; no private trained models. Ad-hoc signed, not Apple notarized. CI validates packaging; physical Mac VM startup, Ethernet/hand operation and visual glass acceptance remain pending. Hand 1 USB passthrough is not implemented; use an external Linux controller for USB devices."
